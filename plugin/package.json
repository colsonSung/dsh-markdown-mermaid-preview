{
  "name": "dsh-markdown-mermaid-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Preview and edit workspace Markdown, Mermaid, HTML/SVG and image files inside the DeepSeek Harness web UI.",
  "license": "MIT",
  "author": "Ethan Song",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colsonSung/dsh-markdown-mermaid-preview.git"
  },
  "homepage": "https://github.com/colsonSung/dsh-markdown-mermaid-preview#readme",
  "bugs": {
    "url": "https://github.com/colsonSung/dsh-markdown-mermaid-preview/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "markdown",
    "mermaid",
    "preview",
    "viewer",
    "document-preview"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "build.mjs",
    "src",
    "client.js",
    "client.mermaid.js",
    "client.editor.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
